<?xml version="1.0" encoding="utf-8"?>
<!-- Nessun dato dell'app va nel backup di Google ne' passa a un nuovo telefono da solo:
     per spostare i dati si usa il backup cifrato di DoctorWood. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
